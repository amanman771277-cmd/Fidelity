{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "Portfolio project post created via Admin Panel and displayed to visitors",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "titleAm": { "type": "string", "maxLength": 200 },
        "sector": { "type": "string", "enum": ["architects", "branding", "furniture"] },
        "description": { "type": "string", "maxLength": 2000 },
        "descriptionAm": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "client": { "type": "string", "maxLength": 200 },
        "clientAm": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 },
        "locationAm": { "type": "string", "maxLength": 200 },
        "year": { "type": "string", "maxLength": 50 },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "sector", "description", "imageUrl"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Collection of global public portfolio posts"
    }
  }
}
